#!/usr/bin/env bash
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VPSG_ROOT="${VPSG_ROOT:-$(cd "$SELF_DIR/.." && pwd)}"
export VPSG_ROOT
# shellcheck source=../core/common.sh
. "$VPSG_ROOT/core/common.sh"
# shellcheck source=../core/platform.sh
. "$VPSG_ROOT/core/platform.sh"
# shellcheck source=../core/router.sh
. "$VPSG_ROOT/core/router.sh"
# shellcheck source=../core/inspect.sh
. "$VPSG_ROOT/core/inspect.sh"
# shellcheck source=../core/transaction.sh
. "$VPSG_ROOT/core/transaction.sh"

usage() {
  cat <<USAGE
$VPSG_NAME $VPSG_VERSION

用法:
  vpsg                              交互菜单
  vpsg status                       系统状态总览
  vpsg doctor                       只读安全检查
  vpsg exposure scan                公网暴露面分析
  sudo vpsg baseline create         创建安全基线
  sudo vpsg drift scan              检测配置漂移
  sudo vpsg safe ssh apply          Safe Change（默认 180 秒自动回滚）
  sudo vpsg safe firewall apply     Safe Change（默认 180 秒自动回滚）
  sudo vpsg commit [transaction-id] 确认修改并取消自动回滚
  vpsg safe status                  查看回滚倒计时
  vpsg module list                  列出模块
  vpsg <module> <action> [...]      执行模块操作

注意:
  正常执行 'vpsg ssh apply' 或 'vpsg firewall apply' 也会自动进入 Safe Change，
  必须在倒计时结束前执行 vpsg commit 才会永久保留修改。

模块: system ssh firewall fail2ban bbr swap docker exposure baseline drift
USAGE
}

status_overview() {
  platform_detect || true
  printf '%b%s %s%b\n' "$C_BOLD" "$VPSG_NAME" "$VPSG_VERSION" "$C_RESET"
  printf '系统: %s\n' "${VPSG_OS_PRETTY:-unknown}"
  if p="$(ssh_primary_port 2>/dev/null)"; then printf 'SSH 端口: %s\n' "$p"; else printf 'SSH 端口: 无法唯一确认\n'; fi
  printf 'UFW: '; "$VPSG_ROOT/modules/builtin/firewall/module.sh" status --brief 2>/dev/null || true
  printf 'Fail2Ban: '; "$VPSG_ROOT/modules/builtin/fail2ban/module.sh" status --brief 2>/dev/null || true
  printf 'BBR: '; "$VPSG_ROOT/modules/builtin/bbr/module.sh" status --brief 2>/dev/null || true
  printf 'Swap: '; "$VPSG_ROOT/modules/builtin/swap/module.sh" status --brief 2>/dev/null || true
  printf 'Docker: '; "$VPSG_ROOT/modules/builtin/docker/module.sh" status --brief 2>/dev/null || true
  if _tx_pending_id >/dev/null 2>&1; then
    printf 'Safe Change: 待确认（运行 vpsg safe status 查看倒计时）\n'
  fi
}

doctor() {
  local failures=0
  platform_supported && ok "支持的系统: $VPSG_OS_PRETTY" || { warn "当前只正式支持 Debian/Ubuntu"; failures=$((failures+1)); }
  if p="$(ssh_primary_port 2>/dev/null)"; then ok "确认 SSH 端口: $p"; else warn "无法唯一确认 SSH 端口；不会建议自动启用防火墙"; failures=$((failures+1)); fi
  if [[ -r /etc/ssh/sshd_config ]] && have sshd && sshd -t 2>/dev/null; then ok "OpenSSH 配置语法正常"; else warn "无法验证 OpenSSH 配置"; failures=$((failures+1)); fi
  if [[ -d /etc/ssh/sshd_config.d ]]; then ok "支持 sshd_config.d 配置片段"; else warn "未发现 sshd_config.d"; fi
  have systemctl && ok "systemd 可用" || warn "systemd 不可用"
  have systemctl && ok "Safe Change systemd timer 可用" || { warn "systemctl 不可用，Safe Change 无法启动"; failures=$((failures+1)); }
  have ss && ok "Exposure Analyzer 可用" || { warn "缺少 ss/iproute2"; failures=$((failures+1)); }
  printf '检查完成：%d 项需要关注。\n' "$failures"
}

menu() {
  while true; do
    clear 2>/dev/null || true
    status_overview
    cat <<'MENU'

1. 公网暴露分析
2. 创建/更新安全基线
3. 检测配置漂移
4. SSH 安全配置（Safe Change）
5. UFW 防火墙（Safe Change）
6. 查看/确认 Safe Change
7. Fail2Ban
8. BBR / Swap / Docker
9. 完整体检
0. 退出
MENU
    read -r -p '请选择: ' c
    case "$c" in
      1) route_module exposure scan ;;
      2) route_module baseline create default ;;
      3) route_module drift scan default ;;
      4) route_module ssh plan; if confirm "应用 SSH 安全配置？"; then VPSG_ASSUME_YES=1 tx_safe_apply ssh apply --yes; fi ;;
      5) route_module firewall plan; if confirm "应用 UFW 配置？"; then VPSG_ASSUME_YES=1 tx_safe_apply firewall apply --yes; fi ;;
      6)
        tx_status
        if _tx_pending_id >/dev/null 2>&1 && confirm "已在新 SSH 会话验证正常，确认保留修改？"; then tx_commit; fi
        ;;
      7) route_module fail2ban plan; if confirm "安装/配置 Fail2Ban？"; then VPSG_ASSUME_YES=1 route_module fail2ban apply --yes; fi ;;
      8)
        echo "a) BBR  b) Swap  c) Docker"
        read -r -p '请选择: ' sub
        case "$sub" in a) route_module bbr apply;; b) route_module swap apply;; c) route_module docker apply;; esac
        ;;
      9) doctor ;;
      0) exit 0 ;;
      *) warn "无效选项" ;;
    esac
    printf '\n'; read -r -p '按回车继续...' _
  done
}

safe_command() {
  case "${1:-}" in
    status) tx_status "${2:-}" ;;
    rollback) tx_manual_rollback "${2:-}" ;;
    ssh|firewall)
      local module="$1" action="${2:-}"; shift 2 2>/dev/null || true
      tx_safe_apply "$module" "$action" "$@"
      ;;
    *) error "用法: vpsg safe <ssh|firewall> apply [--timeout 180] [--yes] | safe status | safe rollback"; return 64 ;;
  esac
}

main() {
  case "${1:-}" in
    "") menu ;;
    -h|--help|help) usage ;;
    --version|version) printf '%s\n' "$VPSG_VERSION" ;;
    status) status_overview ;;
    doctor) doctor ;;
    safe) shift; safe_command "$@" ;;
    commit) tx_commit "${2:-}" ;;
    module)
      case "${2:-}" in
        list) module_list ;;
        *) error "用法: vpsg module list"; return 64 ;;
      esac ;;
    *)
      local module="$1" action="${2:-status}"
      shift 2 2>/dev/null || true
      parse_yes_flag "$@"
      export VPSG_ASSUME_YES
      # SSH / firewall apply are protected by Safe Change by default.
      if [[ "$action" == "apply" && ( "$module" == "ssh" || "$module" == "firewall" ) ]]; then
        tx_safe_apply "$module" apply "$@"
      else
        route_module "$module" "$action" "$@"
      fi
      ;;
  esac
}

main "$@"
