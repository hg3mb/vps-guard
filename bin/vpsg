#!/usr/bin/env bash
set -uo pipefail

SELF_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then SELF_PATH="$(readlink -f "$SELF_PATH" 2>/dev/null || printf '%s' "$SELF_PATH")"; fi
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
VPSG_ROOT="${VPSG_ROOT:-$(cd "$SELF_DIR/.." && pwd)}"
export VPSG_ROOT
# shellcheck source=../core/common.sh
. "$VPSG_ROOT/core/common.sh"
# shellcheck source=../core/platform.sh
. "$VPSG_ROOT/core/platform.sh"
# shellcheck source=../core/router.sh
. "$VPSG_ROOT/core/router.sh"
# shellcheck source=../core/inspect.sh
. "$VPSG_ROOT/core/inspect.sh"
# shellcheck source=../core/transaction.sh
. "$VPSG_ROOT/core/transaction.sh"

usage() {
  cat <<USAGE
$VPSG_NAME $VPSG_VERSION

用法:
  vpsg                              新手交互菜单
  vpsg status                       VPS 仪表盘
  vpsg setup guide                  新手安全向导
  vpsg doctor                       只读安全检查
  vpsg exposure scan                实际公网暴露与风险解释
  sudo vpsg baseline create         创建安全基线
  sudo vpsg drift scan              检测服务器之后发生的变化
  sudo vpsg safe ssh apply          SSH Safe Change（失联自动回滚）
  sudo vpsg safe firewall apply     UFW Safe Change（失联自动回滚）
  vpsg safe history                 查看安全变更历史
  sudo vpsg commit [id]             确认 Safe Change
  vpsg users list                   用户与 sudo 权限管理
  vpsg network summary              网络信息/测速/路由/流媒体可达性
  vpsg panel status                 1Panel 集成
  vpsg watch status                 持续安全检查
  sudo vpsg incident collect        只读异常现场采集
  vpsg module list                  列出模块

模块: setup system ssh firewall fail2ban users docker panel network bbr swap exposure baseline drift watch incident
USAGE
}

_run() { route_module "$@"; }

status_overview() {
  platform_detect || true
  printf '%b%s %s%b\n' "$C_BOLD" "$VPSG_NAME" "$VPSG_VERSION" "$C_RESET"
  printf '系统: %s\n' "${VPSG_OS_PRETTY:-unknown}"
  printf '主机: %s  内核: %s\n' "$(hostname 2>/dev/null || echo unknown)" "$(uname -r)"
  printf '内存: %s MB  根分区可用: %s MB\n' "$(memory_mb 2>/dev/null || echo '?')" "$(root_free_mb 2>/dev/null || echo '?')"
  if p="$(ssh_primary_port 2>/dev/null)"; then printf 'SSH: %s/tcp\n' "$p"; else printf 'SSH: 无法唯一确认端口\n'; fi
  printf 'UFW: '; _run firewall status --brief 2>/dev/null || true
  printf 'Fail2Ban: '; _run fail2ban status --brief 2>/dev/null || true
  printf 'Docker: '; _run docker status --brief 2>/dev/null || true
  printf 'BBR: '; _run bbr status --brief 2>/dev/null || true
  printf 'Swap: '; _run swap status --brief 2>/dev/null || true
  local txid txstatus txrc=0
  txid="$(_tx_active_id 2>/dev/null)" || txrc=$?
  if ((txrc==0)); then
    txstatus="$(_tx_state_get "$(_tx_dir_for "$txid")" status)"
    case "$txstatus" in
      pending|commit_pending) printf '%bSafe Change: %s（vpsg safe status）%b\n' "$C_YELLOW" "$txstatus" "$C_RESET" ;;
      *) printf '%bSafe Change: %s — 需要处理（vpsg safe status）%b\n' "$C_RED" "$txstatus" "$C_RESET" ;;
    esac
  elif ((txrc!=1)); then
    printf '%bSafe Change: 状态记录异常 — 拒绝危险修改直到检查完成%b\n' "$C_RED" "$C_RESET"
  fi
  if [[ -d "$VPSG_STATE_DIR/baselines/default" ]]; then
    printf '安全基线: 已创建\n'
  else
    printf '安全基线: 未创建（建议 sudo vpsg baseline create）\n'
  fi
}

doctor() {
  local attention=0 free failed baseline_rc docker_vis
  echo "VPS Guard 安全体检"
  echo "================="
  platform_supported && ok "支持的系统: $VPSG_OS_PRETTY" || { warn "当前只正式支持 Debian/Ubuntu"; attention=$((attention+1)); }
  if p="$(ssh_primary_port 2>/dev/null)"; then ok "确认 SSH 管理端口: $p/tcp"; else warn "无法唯一确认 SSH 端口；Safe Change/UFW 会拒绝猜测"; attention=$((attention+1)); fi
  if [[ -r /etc/ssh/sshd_config ]] && have sshd; then sshd -t 2>/dev/null && ok "OpenSSH 配置语法正常" || { warn "OpenSSH 配置语法异常"; attention=$((attention+1)); }; else warn "未检测到可验证的 OpenSSH Server"; attention=$((attention+1)); fi
  have systemctl && have flock && have sync && ok "Safe Change 所需 systemd + flock + sync 可用" || { warn "缺少 systemd/flock/coreutils sync，危险变更自动回滚不可用"; attention=$((attention+1)); }
  local txid txstatus txrc=0
  txid="$(_tx_active_id 2>/dev/null)" || txrc=$?
  if ((txrc==0)); then
    txstatus="$(_tx_state_get "$(_tx_dir_for "$txid")" status)"
    case "$txstatus" in
      pending|commit_pending) warn "存在未完成 Safe Change: $txstatus ($txid)" ;;
      *) warn "Safe Change 处于异常/恢复状态: $txstatus ($txid)" ;;
    esac
    attention=$((attention+1))
  elif ((txrc!=1)); then
    warn "Safe Change 状态记录存在歧义/损坏；危险修改会 fail closed"
    attention=$((attention+1))
  fi
  have ss && ok "Exposure host socket 扫描可用" || { warn "缺少 ss/iproute2，Exposure 不完整"; attention=$((attention+1)); }
  if have docker; then
    docker_vis="$(inspect_docker_visibility)"; if [[ "$docker_vis" == accessible ]]; then ok "Docker published ports 可扫描"; else warn "Docker 已安装但当前用户无法读取 published ports；请用 sudo vpsg exposure scan"; attention=$((attention+1)); fi
  fi
  if have ufw && ufw status 2>/dev/null | grep -q '^Status: active'; then ok "UFW 已启用"; else warn "UFW 未启用（是否需要取决于你的网络/云防火墙策略）"; attention=$((attention+1)); fi
  if have systemctl && systemctl is-active --quiet fail2ban 2>/dev/null; then ok "Fail2Ban 正在运行"; else warn "Fail2Ban 未运行"; attention=$((attention+1)); fi
  if [[ -d "$VPSG_STATE_DIR/baselines/default" ]]; then
    /bin/bash "$VPSG_ROOT/modules/builtin/baseline/module.sh" verify default >/dev/null 2>&1; baseline_rc=$?
    case "$baseline_rc" in 0) ok "default Baseline 完整性通过";; 30) warn "Baseline 来自旧 schema，建议确认当前状态可信后重建"; attention=$((attention+1));; *) warn "Baseline 完整性验证失败，请调查后再 accept/rebuild"; attention=$((attention+1));; esac
  else info "尚未创建安全基线；系统稳定后建议 sudo vpsg baseline create"; fi
  free="$(root_free_mb 2>/dev/null || echo 0)"; [[ "$free" =~ ^[0-9]+$ ]] && ((free>=1024)) && ok "根分区可用 ${free} MB" || { warn "根分区可用空间偏低: ${free} MB"; attention=$((attention+1)); }
  if have systemctl; then failed="$(systemctl --failed --no-legend 2>/dev/null | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"; [[ "$failed" == 0 ]] && ok "没有 failed systemd units" || { warn "发现 $failed 个 failed systemd units"; attention=$((attention+1)); }; fi
  [[ ! -e /var/run/reboot-required ]] && ok "当前未检测到 reboot-required" || { warn "系统提示需要重启"; attention=$((attention+1)); }
  if have systemctl && systemctl is-enabled --quiet vps-guard-watch.timer 2>/dev/null; then ok "VPS Guard Watch 已启用"; else info "Watch 未启用；建立 Baseline 后可用 sudo vpsg watch enable"; fi
  echo
  printf '体检完成：%d 项需要关注。\n' "$attention"
  ((attention==0)) || echo "下一步建议：sudo vpsg exposure scan；不理解的端口可用 vpsg exposure explain <port>。"
}

menu() {
  while true; do
    clear 2>/dev/null || true
    status_overview
    cat <<'MENU'

安全与变化
  1. 一键安全体检
  2. 看公网到底暴露了什么
  3. 创建安全基线
  4. 检查服务器发生了什么变化
  5. 安全修改 SSH（失联自动恢复）
  6. 安全配置 UFW（失联自动恢复）
  7. Safe Change 状态/历史

日常管理
  8. 用户与 sudo 管理
  9. Fail2Ban
 10. Docker
 11. 1Panel
 12. 网络测速 / 路由 / 流媒体可达性
 13. 系统更新风险检查
 14. BBR / Swap
 15. VPS Guard Watch
 16. 异常现场采集
  0. 退出
MENU
    read -r -p '请选择: ' c
    case "$c" in
      1) doctor ;;
      2) _run exposure scan ;;
      3) _run baseline create default ;;
      4) _run drift scan default ;;
      5) _run ssh plan; if confirm "应用 SSH 安全配置？"; then VPSG_ASSUME_YES=1 tx_safe_apply ssh apply --yes; fi ;;
      6) _run firewall plan; if confirm "应用 UFW 配置？"; then VPSG_ASSUME_YES=1 tx_safe_apply firewall apply --yes; fi ;;
      7) tx_status; echo; tx_history 10 ;;
      8) _run users menu ;;
      9) _run fail2ban plan; if confirm "安装/配置 Fail2Ban？"; then VPSG_ASSUME_YES=1 _run fail2ban apply --yes; fi ;;
      10) _run docker menu ;;
      11) _run panel menu ;;
      12) _run network menu ;;
      13) _run system plan ;;
      14)
        echo "a) BBR  b) Swap"; read -r -p '请选择: ' sub
        case "$sub" in a) _run bbr apply;; b) _run swap apply;; esac ;;
      15) _run watch menu ;;
      16) echo "只读采集进程、端口、登录、systemd、Docker 等现场信息，不复制密钥内容。"; if confirm "生成现场包？"; then _run incident collect; fi ;;
      0) exit 0 ;;
      *) warn "无效选项" ;;
    esac
    printf '\n'; read -r -p '按回车继续...' _
  done
}

safe_command() {
  case "${1:-}" in
    status) tx_status "${2:-}" ;;
    history) tx_history "${2:-20}" ;;
    show) tx_show "${2:-}" ;;
    rollback) tx_manual_rollback "${2:-}" ;;
    ssh|firewall)
      local module="$1" action="${2:-}"; shift 2 2>/dev/null || true
      tx_safe_apply "$module" "$action" "$@"
      ;;
    *) error "用法: vpsg safe <ssh|firewall> apply | safe status | safe history | safe show <id> | safe rollback"; return 64 ;;
  esac
}

main() {
  case "${1:-}" in
    "") menu ;;
    -h|--help|help) usage ;;
    --version|version) printf '%s\n' "$VPSG_VERSION" ;;
    status) status_overview ;;
    doctor) doctor ;;
    safe) shift; safe_command "$@" ;;
    commit) shift; tx_commit "$@" ;;
    module)
      case "${2:-}" in list) module_list;; *) error "用法: vpsg module list"; return 64;; esac ;;
    *)
      local module="$1" action="${2:-status}"
      shift 2 2>/dev/null || true
      parse_yes_flag "$@"; export VPSG_ASSUME_YES
      if [[ "$action" == "apply" && ( "$module" == "ssh" || "$module" == "firewall" ) ]]; then
        tx_safe_apply "$module" apply "$@"
      else
        route_module "$module" "$action" "$@"
      fi
      ;;
  esac
}

main "$@"
