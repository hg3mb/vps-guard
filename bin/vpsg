#!/usr/bin/env bash
set -uo pipefail

SELF_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then SELF_PATH="$(readlink -f "$SELF_PATH" 2>/dev/null || printf '%s' "$SELF_PATH")"; fi
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
VPSG_ROOT="${VPSG_ROOT:-$(cd "$SELF_DIR/.." && pwd)}"
export VPSG_ROOT
# shellcheck source=../core/common.sh
. "$VPSG_ROOT/core/common.sh"
# shellcheck source=../core/platform.sh
. "$VPSG_ROOT/core/platform.sh"
# shellcheck source=../core/router.sh
. "$VPSG_ROOT/core/router.sh"
# shellcheck source=../core/inspect.sh
. "$VPSG_ROOT/core/inspect.sh"
# shellcheck source=../core/transaction.sh
. "$VPSG_ROOT/core/transaction.sh"

usage() {
  cat <<USAGE
$VPSG_NAME $VPSG_VERSION

用法:
  vpsg                              新手交互菜单
  vpsg status                       VPS 仪表盘
  vpsg doctor                       只读安全检查
  vpsg exposure scan                实际公网暴露与风险解释
  sudo vpsg baseline create         创建安全基线
  sudo vpsg drift scan              检测服务器之后发生的变化
  sudo vpsg safe ssh apply          SSH Safe Change（失联自动回滚）
  sudo vpsg safe firewall apply     UFW Safe Change（失联自动回滚）
  vpsg safe history                 查看安全变更历史
  sudo vpsg commit [id]             确认 Safe Change
  vpsg users list                   用户与 sudo 权限管理
  vpsg network summary              网络信息/测速/路由/流媒体可达性
  vpsg panel status                 1Panel 集成
  vpsg watch status                 持续安全检查
  sudo vpsg incident collect        只读异常现场采集
  vpsg module list                  列出模块

模块: system ssh firewall fail2ban users docker panel network bbr swap exposure baseline drift watch incident
USAGE
}

_run() { route_module "$@"; }

status_overview() {
  platform_detect || true
  printf '%b%s %s%b\n' "$C_BOLD" "$VPSG_NAME" "$VPSG_VERSION" "$C_RESET"
  printf '系统: %s\n' "${VPSG_OS_PRETTY:-unknown}"
  printf '主机: %s  内核: %s\n' "$(hostname 2>/dev/null || echo unknown)" "$(uname -r)"
  printf '内存: %s MB  根分区可用: %s MB\n' "$(memory_mb 2>/dev/null || echo '?')" "$(root_free_mb 2>/dev/null || echo '?')"
  if p="$(ssh_primary_port 2>/dev/null)"; then printf 'SSH: %s/tcp\n' "$p"; else printf 'SSH: 无法唯一确认端口\n'; fi
  printf 'UFW: '; _run firewall status --brief 2>/dev/null || true
  printf 'Fail2Ban: '; _run fail2ban status --brief 2>/dev/null || true
  printf 'Docker: '; _run docker status --brief 2>/dev/null || true
  printf 'BBR: '; _run bbr status --brief 2>/dev/null || true
  printf 'Swap: '; _run swap status --brief 2>/dev/null || true
  if _tx_pending_id >/dev/null 2>&1; then
    printf '%bSafe Change: 待确认（vpsg safe status）%b\n' "$C_YELLOW" "$C_RESET"
  fi
  if [[ -d "$VPSG_STATE_DIR/baselines/default" ]]; then
    printf '安全基线: 已创建\n'
  else
    printf '安全基线: 未创建（建议 sudo vpsg baseline create）\n'
  fi
}

doctor() {
  local failures=0
  platform_supported && ok "支持的系统: $VPSG_OS_PRETTY" || { warn "当前只正式支持 Debian/Ubuntu"; failures=$((failures+1)); }
  if p="$(ssh_primary_port 2>/dev/null)"; then ok "确认 SSH 端口: $p"; else warn "无法唯一确认 SSH 端口；不会自动启用防火墙"; failures=$((failures+1)); fi
  if [[ -r /etc/ssh/sshd_config ]] && have sshd && sshd -t 2>/dev/null; then ok "OpenSSH 配置语法正常"; else warn "无法验证 OpenSSH 配置"; failures=$((failures+1)); fi
  have systemctl && ok "systemd / Safe Change timer 可用" || { warn "systemd 不可用，失联自动回滚无法工作"; failures=$((failures+1)); }
  have ss && ok "Exposure Analyzer 可用" || { warn "缺少 ss/iproute2"; failures=$((failures+1)); }
  have curl && ok "网络诊断依赖 curl 可用" || warn "缺少 curl，网络/1Panel 部分功能需要安装"
  printf '检查完成：%d 项需要关注。\n' "$failures"
}

menu() {
  while true; do
    clear 2>/dev/null || true
    status_overview
    cat <<'MENU'

安全与变化
  1. 一键安全体检
  2. 看公网到底暴露了什么
  3. 创建安全基线
  4. 检查服务器发生了什么变化
  5. 安全修改 SSH（失联自动恢复）
  6. 安全配置 UFW（失联自动恢复）
  7. Safe Change 状态/历史

日常管理
  8. 用户与 sudo 管理
  9. Fail2Ban
 10. Docker
 11. 1Panel
 12. 网络测速 / 路由 / 流媒体可达性
 13. 系统更新风险检查
 14. BBR / Swap
 15. VPS Guard Watch
 16. 异常现场采集
  0. 退出
MENU
    read -r -p '请选择: ' c
    case "$c" in
      1) doctor ;;
      2) _run exposure scan ;;
      3) _run baseline create default ;;
      4) _run drift scan default ;;
      5) _run ssh plan; if confirm "应用 SSH 安全配置？"; then VPSG_ASSUME_YES=1 tx_safe_apply ssh apply --yes; fi ;;
      6) _run firewall plan; if confirm "应用 UFW 配置？"; then VPSG_ASSUME_YES=1 tx_safe_apply firewall apply --yes; fi ;;
      7) tx_status; echo; tx_history 10 ;;
      8) _run users menu ;;
      9) _run fail2ban plan; if confirm "安装/配置 Fail2Ban？"; then VPSG_ASSUME_YES=1 _run fail2ban apply --yes; fi ;;
      10) _run docker menu ;;
      11) _run panel menu ;;
      12) _run network menu ;;
      13) _run system plan ;;
      14)
        echo "a) BBR  b) Swap"; read -r -p '请选择: ' sub
        case "$sub" in a) _run bbr apply;; b) _run swap apply;; esac ;;
      15) _run watch menu ;;
      16) echo "只读采集进程、端口、登录、systemd、Docker 等现场信息，不复制密钥内容。"; if confirm "生成现场包？"; then _run incident collect; fi ;;
      0) exit 0 ;;
      *) warn "无效选项" ;;
    esac
    printf '\n'; read -r -p '按回车继续...' _
  done
}

safe_command() {
  case "${1:-}" in
    status) tx_status "${2:-}" ;;
    history) tx_history "${2:-20}" ;;
    show) tx_show "${2:-}" ;;
    rollback) tx_manual_rollback "${2:-}" ;;
    ssh|firewall)
      local module="$1" action="${2:-}"; shift 2 2>/dev/null || true
      tx_safe_apply "$module" "$action" "$@"
      ;;
    *) error "用法: vpsg safe <ssh|firewall> apply | safe status | safe history | safe show <id> | safe rollback"; return 64 ;;
  esac
}

main() {
  case "${1:-}" in
    "") menu ;;
    -h|--help|help) usage ;;
    --version|version) printf '%s\n' "$VPSG_VERSION" ;;
    status) status_overview ;;
    doctor) doctor ;;
    safe) shift; safe_command "$@" ;;
    commit) tx_commit "${2:-}" ;;
    module)
      case "${2:-}" in list) module_list;; *) error "用法: vpsg module list"; return 64;; esac ;;
    *)
      local module="$1" action="${2:-status}"
      shift 2 2>/dev/null || true
      parse_yes_flag "$@"; export VPSG_ASSUME_YES
      if [[ "$action" == "apply" && ( "$module" == "ssh" || "$module" == "firewall" ) ]]; then
        tx_safe_apply "$module" apply "$@"
      else
        route_module "$module" "$action" "$@"
      fi
      ;;
  esac
}

main "$@"
